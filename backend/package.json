{
  "name": "backend",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "start": "node server.js",
    "electron": "electron .",
    "build:exe": "electron-builder"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "pg": "^8.23.1",
    "sql.js": "^1.10.3"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.motoparts.pos",
    "productName": "MotoParts POS",
    "directories": {
      "output": "dist-electron"
    },
    "asar": false,
    "files": [
      "main.js",
      "server.js",
      "database.db",
      "node_modules/**/*",
      "public/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
